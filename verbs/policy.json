    "Exchange Online": ["^EXO", "^(?:CAS|Remote|Site|Shared|Room|Equipment|Linked)?Mailbox", "^Mailbox", "^ComplianceCase", "^RetentionCompliance", "^ComplianceTag", "^UnifiedAuditLog", "^InboxRule", "^TransportRule", "^Recipient", "^DistributionGroup", "^DynamicDistributionGroup", "^UnifiedGroup", "^OrganizationConfig", "^RemoteDomain", "^AcceptedDomain", "^ComplianceSearch", "^RetentionPolicy", "^RetentionPolicyTag", "^Dlp", "^HostedContentFilter", "^HostedOutboundSpamFilter", "^AntiPhish", "^SafeLinks", "^SafeAttachment", "^MalwareFilter", "^MobileDevice", "^MessageTrace", "^AuditLog", "^AdminAuditLogConfig", "^MailboxAudit", "^User$", "^Contact$", "^MailContact", "^MailUser", "^ManagementRole", "^RoleGroup", "^AuthenticationPolicy", "^OwaMailboxPolicy", "^MobileDeviceMailboxPolicy", "^SharingPolicy", "^InboundConnector", "^OutboundConnector", "^TenantAllowBlockList", "^Quarantine", "^DkimSigningConfig", "^ArcConfig", "^AtpPolicy", "^ATPProtectionPolicy", "^ReportSubmission", "^OrganizationRelationship", "^PhishSim", "^JournalRule", "^Group$", "^ConnectionInformation", "^ExchangeOnline", "^IPPSSession", "^Label$", "^LabelPolicy", "^ProtectionAlert", "^ActivityAlert", "^SupervisoryReview", "^Migration", "^MoveRequest", "^EOP", "^BlockedSenderAddress", "^HostedConnectionFilter", "^FocusedInbox", "^Clutter", "^CalendarProcessing", "^MailboxCalendarConfiguration", "^MailboxRegionalConfiguration", "^MailboxJunkEmailConfiguration", "^MailboxAutoReplyConfiguration"],
    "Microsoft Teams": ["^Team", "^Cs"],
    "SharePoint Online": ["^SPO", "^PnP"],
    "Entra ID (legacy module)": ["^AzureAD", "^Msol", "^Entra"],
    "Intune / Microsoft 365 admin": ["^Intune", "^DeviceManagement", "^M365"],
    "Azure": ["^Az(?!ureAD)[A-Z]", "^AzureStorage", "^AzureRm"],
    "Entra ID sign-in (MSAL.PS)": ["^Msal"],
    "Active Directory (on-premises)": ["^AD[A-Z]"]
  },
  "local_harmless": ["Write-Host", "Write-Output", "Write-Verbose", "Write-Warning", "Write-Error", "Write-Information", "Write-Debug", "Write-Progress", "Out-Null", "Out-String", "Out-Host", "Out-Default", "Out-GridView", "Set-Location", "Set-Variable", "Set-StrictMode", "Set-Item", "New-Object", "New-TimeSpan", "New-Guid", "New-Variable", "New-PSDrive", "Add-Member", "Select-Object", "Sort-Object", "Where-Object", "ForEach-Object", "Group-Object", "Measure-Object", "Compare-Object", "Tee-Object", "Format-Table", "Format-List", "Format-Wide", "Format-Custom", "Join-Path", "Split-Path", "Test-Path", "Resolve-Path", "Get-Date", "Start-Sleep", "Read-Host", "Get-Location", "Push-Location", "Pop-Location", "Import-Module", "Get-Module", "Get-Command", "Get-Help", "Get-Member", "Get-Variable", "Get-Item", "Get-ChildItem", "Get-Content", "Get-PSRepository", "Get-PackageProvider", "Get-InstalledModule", "Get-Random", "Get-Culture", "Get-Host", "Get-Process", "Get-Service", "Get-Error", "Update-TypeData", "Update-FormatData", "Register-ArgumentCompleter", "Import-Csv", "Import-Clixml", "ConvertTo-Json", "ConvertFrom-Json", "ConvertTo-Csv", "ConvertFrom-Csv", "ConvertTo-Html", "ConvertTo-SecureString", "ConvertFrom-SecureString", "Get-Credential", "Start-Transcript", "Stop-Transcript", "Get-Acl", "Set-PSReadLineOption", "Get-PSReadLineOption", "Set-PSReadLineKeyHandler", "Get-Unique", "Select-String", "Get-EventLog", "Get-WinEvent", "Get-ItemProperty", "Get-ComputerInfo", "Get-NetIPAddress", "Get-DnsClientCache", "Resolve-DnsName", "Test-NetConnection", "Test-Connection", "Get-Clipboard", "Set-Clipboard", "Get-ExecutionPolicy", "Get-AuthenticodeSignature", "Clear-Host", "Remove-Module", "Remove-PSSession", "Remove-Variable", "Clear-Variable", "Remove-Job", "Remove-PSDrive", "New-Item", "Out-File", "Set-Content", "Add-Content", "Export-Csv", "Export-Clixml", "Copy-Item", "Move-Item", "Rename-Item", "Expand-Archive", "Import-PSSession", "Get-PSSession", "Export-ModuleMember", "Receive-Job", "Get-PSCallStack", "Get-PSDrive", "Find-Module", "Get-FileHash", "Get-CimInstance", "Get-WmiObject", "Get-HotFix", "Get-Disk", "Get-Volume", "Get-NetAdapter", "Get-NetFirewallRule", "Get-LocalUser", "Get-LocalGroup", "Get-LocalGroupMember", "Get-ScheduledTask", "Get-BitLockerVolume", "Get-Tpm", "Get-MpComputerStatus", "Get-MpPreference", "Get-AppxPackage", "Get-AppxProvisionedPackage", "Get-Package", "Export-Certificate", "Export-PfxCertificate", "Join-String", "Import-LocalizedData", "Import-PowerShellDataFile"],
  "local_rules": [
    ["DESTRUCTIVE", "^(Remove-Item|ri|rm|del|erase|rd|rmdir)$", "-Recurse", "deletes a local folder tree", ""],
    ["DESTRUCTIVE", "^(Format-Volume|Clear-Disk|Initialize-Disk|Remove-Partition)$", "", "erases a disk", ""],
    ["DESTRUCTIVE", "^(Restart-Computer|Stop-Computer)$", "", "restarts or shuts down the computer", ""],
    ["CHANGES", "^(Remove-Item|ri|rm|del|erase|rd|rmdir)$", "", "deletes local files", ""],
    ["CHANGES", "^Clear-Content$", "", "empties a local file", ""],
    ["CHANGES", "^(Stop-Process|kill|spps|Stop-Service|Restart-Service|Set-Service)$", "", "stops or changes a program or service on your computer", ""],
    ["CHANGES", "^(Install-Module|Update-Module|Install-PackageProvider|Install-Package|Install-Script|Save-Module)$", "", "installs or updates a module on your computer", ""],
    ["CHANGES", "^Uninstall-Module$", "", "removes a module from your computer", ""],
    ["CHANGES", "^Set-ExecutionPolicy$", "", "changes which scripts Windows will run", "weakens script protection on your computer"],
    ["CHANGES", "^(Register-PSRepository|Set-PSRepository)$", "", "changes where modules are installed from", "a repository marked Trusted installs without asking"],
    ["CHANGES", "^(Set-ItemProperty|New-ItemProperty|Remove-ItemProperty|Set-Acl)$", "", "changes a registry key or file permission", ""],
    ["CHANGES", "^(New-ScheduledTask|Register-ScheduledTask|Set-ScheduledTask)$", "", "creates a scheduled task on your computer", "a scheduled task keeps running after the script ends"],
    ["CHANGES", "^(New-LocalUser|Add-LocalGroupMember|Set-LocalUser|Enable-LocalUser)$", "", "changes local Windows accounts", "adds or changes a local account"],
    ["CHANGES", "^(Send-MailMessage)$", "", "sends an email from this computer", "can send tenant data out by email"],
    ["READ-ONLY", "^(New-PSSession|nsn)$", "", "opens a remote PowerShell session; what runs in it shows on the lines that use it", ""],
    ["CANNOT TELL", "^(Invoke-Command|icm|Enter-PSSession|Start-Job|sajb|Start-ThreadJob)$", "", "runs code somewhere the checker cannot follow (a job, a session or another computer)", ""],
    ["CANNOT TELL", "^(Start-Process|saps|start)$", "", "starts another program; what it does depends on that program", ""],
    ["CANNOT TELL", "^Invoke-Item$", "", "opens a file with its default program; a program or script would run", ""],
    ["CANNOT TELL", "^(Invoke-CimMethod|Invoke-WmiMethod)$", "", "calls a Windows management method the checker cannot classify", ""],
    ["CHANGES", "^(Set-MpPreference|Add-MpPreference|Remove-MpPreference)$", "", "changes Microsoft Defender settings", "can switch off real-time protection or exclude folders from scanning"],
    ["CHANGES", "^Enable-PSRemoting$", "", "switches on remote PowerShell (WinRM) into this computer", "lets other machines run commands on this computer"],
    ["CHANGES", "^Unblock-File$", "", "removes the downloaded-file warning from a file", "Windows will no longer warn before running it"],
    ["SUSPICIOUS", "^(Invoke-Expression|iex)$", "", "runs text as code; the checker cannot see what", ""],
    ["SUSPICIOUS", "^Add-Type$", "", "compiles and loads .NET code the checker cannot classify", ""]
  ],
  "path_rules": [
    ["CHANGES", "^(Add-Content|Set-Content|Out-File|New-Item|Copy-Item|Move-Item|Set-Item|Set-ItemProperty|New-ItemProperty|Export-\\w+)$", "(?i)\\$profile\\b|profile\\.ps1|[\\\\/]Startup[\\\\/]|CurrentVersion[\\\\/]Run(?:Once)?\\b|[\\\\/]Start Menu[\\\\/]", "writes where code runs automatically at every start", "persistence: whatever is written here runs every time PowerShell or Windows starts"],
    ["CHANGES", "^(Add-Content|Set-Content|Out-File|Copy-Item|Move-Item|Set-Item)$", "(?i)[\\\\/]drivers[\\\\/]etc[\\\\/]hosts\\b", "changes the hosts file", "can point Microsoft sign-in addresses at another server"],
    ["CHANGES", "^(Set-Item|New-Item|Set-ItemProperty|New-ItemProperty)$", "(?i)\\bWSMan:", "changes a remoting (WinRM) setting", "TrustedHosts * lets this computer send its credentials to any machine"],
    ["CHANGES", "^(Set-Item|New-Item|Set-Content|Remove-Item|Clear-Item)$", "(?i)\\b(?:HKLM|HKCU|HKCR|HKU):|Registry::", "changes a registry key", ""],
    ["CANNOT TELL", "^(Add-Content|Set-Content|Out-File|Copy-Item|Move-Item|Export-\\w+|New-Item)$", "(?<![\\\\\\w])\\\\\\\\[\\w.-]+\\\\", "writes to a network share on another computer; the checker cannot see whose", "collected data can leave this way"]
  ],
  "known_scripts": [
    ["CHANGES", "^Get-WindowsAutopilotInfo$", "-Online", "uploads this computer's hardware hash to Windows Autopilot in the tenant", "", "delete the device under Windows Autopilot devices in Intune", "tenant"],
    ["READ-ONLY", "^Get-WindowsAutopilotInfo$", "", "reads this computer's hardware hash (written to -OutputFile if given)", "", "", "local"]
  ],
  "write_cmdlets": ["Set-Content", "Add-Content", "Out-File", "New-Item", "Set-Item", "Set-ItemProperty", "New-ItemProperty", "Set-Clipboard"],
  "code_in_text": "(?i)\\b(?:iex|irm|iwr|Invoke-(?:Expression|WebRequest|RestMethod)|FromBase64String|(?:powershell|pwsh)(?:\\.exe)?\\s+-|-(?:EncodedCommand|enc|ec)\\b|-e\\s+[A-Za-z0-9+/=]{16,})",
  "native_exes": {
    "CANNOT TELL": ["cmd", "cmd.exe", "powershell", "powershell.exe", "pwsh", "pwsh.exe", "bash", "sh", "zsh", "python", "python3", "osascript", "sudo", "launchctl", "defaults", "reg", "reg.exe", "net", "net.exe", "net1", "sc.exe", "schtasks", "schtasks.exe", "msiexec", "msiexec.exe", "curl.exe", "wget.exe", "rm", "cp", "mv", "chmod", "chown", "wmic", "wmic.exe", "dsregcmd", "gpupdate", "runas", "taskkill"],
    "SUSPICIOUS": ["mshta", "mshta.exe", "regsvr32", "regsvr32.exe", "rundll32", "rundll32.exe", "certutil", "certutil.exe", "bitsadmin", "bitsadmin.exe", "wscript", "wscript.exe", "cscript", "cscript.exe", "installutil", "installutil.exe", "msbuild", "msbuild.exe"]
  },
  "native_rules": [
    ["DESTRUCTIVE", "^vssadmin(\\.exe)?$", "^\\s*(?:delete|resize)\\b", "deletes Volume Shadow Copies (Windows restore points)", "ransomware deletes these first so files cannot be restored"],
    ["DESTRUCTIVE", "^wevtutil(\\.exe)?$", "^\\s*(?:cl|clear-log)\\b", "clears a Windows event log", "erases the record of what ran on this computer"]
  ],
  "dotnet_rules": [
    ["SUSPICIOUS", "(?i)\\[(?:System\\.)?Reflection\\.Assembly\\]::(?:Load|LoadFrom|LoadFile|UnsafeLoadFrom)\\s*\\(", "loads a .NET assembly from data the checker cannot see"],
    ["SUSPICIOUS", "(?i)\\[(?:System\\.Management\\.Automation\\.)?ScriptBlock\\]::Create", "turns text into runnable code"],
    ["SUSPICIOUS", "(?i)\\.(?:DownloadString|DownloadData|DownloadFile)\\s*\\(", "downloads from the internet inside .NET, outside the cmdlets the checker reads"],
    ["SUSPICIOUS", "(?i)\\[(?:System\\.)?Net\\.(?:WebClient|Http\\.HttpClient|Sockets\\.\\w+|HttpWebRequest|WebRequest)\\]|New-Object\\s+(?:-TypeName\\s+)?['\"]?(?:System\\.)?Net\\.(?:WebClient|Http\\.HttpClient|Sockets\\.\\w+)", "opens a network connection inside .NET, outside the cmdlets the checker reads"],
    ["SUSPICIOUS", "(?i)\\[(?:System\\.)?Diagnostics\\.Process\\]::Start", "starts a program from inside .NET, outside the cmdlets the checker reads"],
    ["SUSPICIOUS", "(?i)-ComObject\\s+['\"]?(?:WScript\\.Shell|Shell\\.Application|Schedule\\.Service|MSXML2\\.\\w+|WinHttp\\.WinHttpRequest\\.\\w+|InternetExplorer\\.Application)", "uses a Windows COM object that can run programs, create scheduled tasks or fetch from the internet"],
    ["SUSPICIOUS", "(?i)InvokeCommand\\.InvokeScript|\\[PowerShell\\]::Create|\\.AddScript\\s*\\(", "turns text into runnable code"],
    ["SUSPICIOUS", "(?i)\\[(?:System\\.)?Convert\\]::FromBase64String", "decodes hidden text; if it is then run, the checker cannot see what"],
    ["SUSPICIOUS", "(?i)-(?:EncodedCommand|enc|ec)\\b|-e\\s+[A-Za-z0-9+/=]{16,}", "runs a hidden (base64) command"],
    ["CANNOT TELL", "(?i)\\.Invoke\\s*\\(|\\.InvokeMember\\s*\\(|\\.GetMethod\\s*\\(|\\.(?:Run|Exec|ShellExecute)\\s*\\(", "calls a .NET or COM method the checker cannot classify; Run and Exec start programs"],
    ["CANNOT TELL", "(?i)GetNetworkCredential\\(\\)\\.Password|ConvertFrom-SecureString\\s[^\\n]*-AsPlainText", "turns a password back into plain text; watch where it goes next"],
    ["DESTRUCTIVE", "(?i)\\[(?:System\\.)?IO\\.Directory\\]::Delete\\s*\\(", "deletes a local folder through .NET, outside the cmdlets the checker reads"],
    ["CHANGES", "(?i)\\[(?:System\\.)?IO\\.(?:File\\]::(?:Delete|Move|Copy|Replace|WriteAll\\w*|AppendAll\\w*|Create\\w*|Encrypt|Decrypt|SetAttributes)|Directory\\]::(?:Move|Copy|Replace|WriteAll\\w*|AppendAll\\w*|Create\\w*|Encrypt|Decrypt|SetAttributes))\\s*\\(", "writes, moves or deletes local files through .NET, outside the cmdlets the checker reads"],
    ["DESTRUCTIVE", "(?i)\\.(?:DeleteObject\\s*\\(\\s*\\)|Recycle\\s*\\(\\s*\\)|DeleteWithParameters\\s*\\()", "deletes a SharePoint object through the CSOM API (it happens at the next ExecuteQuery or Invoke-PnPQuery)"],
    ["CHANGES", "(?i)\\.(?:BreakRoleInheritance|ResetRoleInheritance)\\s*\\(|\\.RoleAssignments\\.Add\\s*\\(", "changes SharePoint permissions through the CSOM API"],
    ["CHANGES", "(?i)\\.Delete\\s*\\(", "calls a .Delete() method on an object; the checker cannot see what it deletes"]
  ],
  "cmdlet_overrides": [
    ["DESTRUCTIVE", "^Search-Mailbox$", "-DeleteContent", "deletes mail from mailboxes", "", "deleted items go to the Recoverable Items folder for the mailbox's retention period (default 14 days)", "https://learn.microsoft.com/exchange/security-and-compliance/in-place-ediscovery/delete-and-recover-messages"],
    ["DESTRUCTIVE", "^New-ComplianceSearchAction$", "-Purge", "purges mail found by a compliance search", "", "a SoftDelete purge is recoverable by the user until retention expires; a HardDelete purge is not", "https://learn.microsoft.com/purview/ediscovery-search-for-and-delete-email-messages"],
    ["CHANGES", "^New-ComplianceSearchAction$", "", "runs an action on a compliance search (export or preview unless -Purge)", "", "", ""],
    ["READ-ONLY", "^(Connect|Disconnect)-(MgGraph|ExchangeOnline|IPPSSession|MicrosoftTeams|PnPOnline|SPOService|Entra|AzureAD|MsolService|AzAccount|AzureRmAccount|AIPService)$", "", "signs in to, or out of, a tenant", "", "", ""],
    ["CHANGES", "^Confirm-Mg(Beta)?(RiskyUser|RiskyServicePrincipal|RiskyAgent|AuditLogSignIn)(Compromised|Safe)$", "", "marks a user, app or sign-in as compromised or safe in Entra ID Protection", "sets the risk level that risk-based sign-in policies act on", "", "https://learn.microsoft.com/powershell/module/microsoft.graph.identity.signins/confirm-mgriskyusercompromised"],
    ["CHANGES", "^Confirm-(Mg(Beta)?Domain|Entra(Beta)?Domain|AzureADDomain|MsolDomain)$", "", "verifies a domain in the tenant", "", "", ""],
    ["CHANGES", "^Convert-MsolDomainTo(Federated|Standard)$", "", "switches a domain between federated single sign-on and standard sign-in", "changes how every user in the domain signs in", "", ""],
    ["CHANGES", "^Convert-MsolFederatedUser$", "", "updates a user after their domain was switched from federated to standard sign-in", "", "", ""],
    ["CHANGES", "^Confirm-Mg(Beta)?.*TimeCard(ForUser)?$", "", "confirms a Teams Shifts time card", "", "", ""],
    ["CHANGES", "^Convert-Mg(Beta)?UserExternalToInternalMemberUser$", "", "converts an external user into an internal member", "the user signs in to this tenant as a member", "", ""],
    ["CHANGES", "^Export-Mg(Beta)?.*(Ediscovery.*|PersonalData|DeviceAndAppManagementData)$", "", "starts an export of tenant data", "copies mail, files or personal data out for download", "", ""],
    ["CHANGES", "^Find-Mg(Beta)?.*(ManagedDevice|ComanagedDevice)$", "", "locates a managed device (a remote device action)", "", "", ""],
    ["CHANGES", "^Get-Mg(Beta)?.*SynchronizationAccessToken$", "", "acquires a token that authorizes Entra provisioning into an app (a POST)", "", "", ""],
    ["DESTRUCTIVE", "^Import-TransportRuleCollection$", "", "replaces every mail flow rule in the organization with the imported file", "changes how mail flows in or out of the tenant", "re-import a backup taken with Export-TransportRuleCollection", "https://learn.microsoft.com/powershell/module/exchangepowershell/import-transportrulecollection"],
    ["CHANGES", "^Validate-OutboundConnector$", "", "tests a connector by sending test email through it", "", "", ""],
    ["CHANGES", "^ConvertTo-PnPPage$", "", "converts a classic SharePoint page into a modern page", "", "", ""],
    ["CHANGES", "^Resolve-PnPFolder$", "", "creates the SharePoint folder if it does not exist", "", "", ""],
    ["CHANGES", "^Use-PnPBrandCenterFontPackage$", "", "applies a Brand Center font to the site", "", "", ""],
    ["READ-ONLY", "^Select-MgProfile$", "", "chooses the Graph API version", "", "", ""],
    ["READ-ONLY", "^Import-Module$", "", "loads a module", "", "", ""],
    ["CHANGES", "^Set-MgUserLicense$", "", "adds or removes licences", "", "", ""],
    ["CHANGES", "^Revoke-", "", "revokes a session, token or permission", "signs users out or removes access", "", ""],
    ["CHANGES", "^Reset-MgUserAuthenticationMethodPassword$", "", "resets a user's password", "changes a credential", "", ""],
    ["CHANGES", "^Invoke-Mg", "", "runs a Graph action", "", "", ""]
  ],
  "security_rules": [
    ["(?i)-(?:Forwarding\\w*|DeliverToMailboxAndForward|ForwardTo|ForwardAsAttachmentTo|RedirectTo)\\b", "sets up mail forwarding"],
    ["(?i)^(Add|Set)-MailboxPermission$|^Add-RecipientPermission$|^(Add|Set)-MailboxFolderPermission$|^Add-ADPermission$", "gives someone access to a mailbox"],
    ["(?i)^(New|Set|Enable|Disable)-InboxRule$|/messageRules\\b", "creates or changes an inbox rule (a common attacker foothold)"],
    ["(?i)^(New|Set)-TransportRule$|^(New|Set)-(Inbound|Outbound)Connector$|^Set-RemoteDomain$", "changes how mail flows in or out of the tenant"],
    ["(?i)^Set-CASMailbox$|^Set-OrganizationConfig$|^Set-AuthenticationPolicy$|^Set-OwaMailboxPolicy$", "changes tenant-wide mail or client access settings"],
    ["(?i)^(Set|Disable)-AdminAuditLogConfig$|^Set-MailboxAuditBypassAssociation$|AuditDisabled|-AuditEnabled\\s+\\$false", "weakens audit logging"],
    ["(?i)ConditionalAccess|^Update-MgPolicyAuthorizationPolicy$|^Update-MgPolicyAuthenticationMethodPolicy$|^Update-MgPolicyIdentitySecurityDefaultEnforcementPolicy$|^Set-MsolCompanySettings$|^Update-MgPolicyCrossTenantAccessPolicy", "changes a tenant security policy"],
    ["(?i)^(New|Update|Remove)-MgUserAuthentication\\w*Method|StrongAuthentication|^Reset-MgUserAuthenticationMethodPassword$|^Set-MsolUser\\b.*-StrongAuthentication|PasswordProfile|^Set-MsolUserPassword$|^Set-AzureADUserPassword$", "changes a user's password or second factor"],
    ["(?i)^(New|Update|Remove)-Mg(Application|ServicePrincipal)|^Add-Mg(Application|ServicePrincipal)(Password|Key)$|^New-MgOauth2PermissionGrant$|^New-MgServicePrincipalAppRoleAssignment|^New-AzureADApplication|^New-AzureADServicePrincipal|-AllowAppRegistration", "creates or changes an app registration, secret or app permission"],
    ["(?i)^New-MgDirectoryRoleMemberByRef$|^New-MgRoleManagementDirectoryRoleAssignment|^Add-MsolRoleMember$|^Add-AzureADDirectoryRoleMember$|^Add-RoleGroupMember$|^New-ManagementRoleAssignment$|^New-MgRoleManagementDirectoryRoleEligibility|^Set-SPOUser\\b.*-IsSiteCollectionAdmin", "grants an admin role"],
    ["(?i)^(New|Remove)-MgUser$|^(New|Remove)-Mailbox$|^(New|Remove)-MsolUser$|^(New|Remove)-AzureADUser$", "creates or deletes a user account"],
    ["(?i)^Set-SPOTenant$|^Set-SPOSite\\b.*-SharingCapability|^Set-PnPTenant$|SharingCapability|-ExternalUserAndGuestSharing", "changes external sharing"],
    ["(?i)^New-MgInvitation$|^New-AzureADMSInvitation$|GuestUser", "invites an external (guest) user"],
    ["(?i)^Set-MgUser\\b.*-AccountEnabled|^Update-MgUser\\b.*-AccountEnabled|^Set-MsolUser\\b.*-BlockCredential|^Set-AzureADUser\\b.*-AccountEnabled", "enables or disables sign-in for an account"],
    ["(?i)^(Enable|Disable)-Mailbox$|^Set-Mailbox\\b.*-LitigationHold|-RetentionHoldEnabled", "changes mailbox holds or mailbox state"],
    ["(?i)ConvertTo-SecureString\\s.*-AsPlainText|-ClientSecret\\s+['\"]|-Password\\s+['\"]|-CertificateThumbprint|-ClientSecretCredential", "carries a credential inside the script"],
    ["(?i)^New-CsTeamsAppPermissionPolicy|^Set-CsTenantFederationConfiguration$|^Set-CsExternalAccessPolicy$", "changes Teams external access"],
    ["(?i)^Send-MgUserMail$|^Send-MgUserMessage|^Send-MailMessage$", "sends email; collected data can leave this way"],
    ["(?i)Win32_Process\\b", "starts a program through WMI (Win32_Process Create)"],
    ["(?i)GetNetworkCredential\\(\\)\\.Password|ConvertFrom-SecureString\\s.*-AsPlainText", "turns a password back into plain text"],
    ["(?i)^Release-QuarantineMessage$", "releases quarantined mail, held as spam, phishing or malware, to its recipients"],
    ["(?i)ActivationLock$", "bypasses Activation Lock on a device"],
    ["(?i)^Connect-Mailbox$", "gives a user account full access to a mailbox and all its mail"],
    ["(?i)PasswordSingleSignOnCredential", "reads or changes the passwords stored for password-based single sign-on"]
  ],
  "undo": [
    ["^Remove-MgUser$|^Remove-AzureADUser$|^Remove-MsolUser$", "an admin can restore a deleted user for 30 days", "https://learn.microsoft.com/entra/fundamentals/users-restore"],
    ["^Remove-MgGroup$|^Remove-UnifiedGroup$|^Remove-AzureADMSGroup$", "a Microsoft 365 group or cloud security group can be restored for 30 days; Microsoft documents no window for other group types", "https://learn.microsoft.com/entra/identity/users/groups-restore-deleted"],
    ["^Remove-Mailbox$", "a deleted mailbox can be restored for 30 days", "https://learn.microsoft.com/exchange/recipients-in-exchange-online/delete-or-restore-mailboxes"],
    ["^Remove-Mg(Application|ServicePrincipal)$|^Remove-AzureADApplication$", "a deleted app registration can be restored for 30 days", "https://learn.microsoft.com/entra/identity-platform/howto-restore-app"],
