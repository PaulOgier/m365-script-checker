  "security_rules": [
    ["(?i)-(?:Forwarding\\w*|DeliverToMailboxAndForward|ForwardTo|ForwardAsAttachmentTo|RedirectTo)\\b", "sets up mail forwarding"],
    ["(?i)^(Add|Set)-MailboxPermission$|^Add-RecipientPermission$|-GrantSendOnBehalfTo\\b|^(Add|Set)-MailboxFolderPermission$|^Add-ADPermission$", "gives someone access to a mailbox"],
    ["(?i)^(New|Set|Enable|Disable)-InboxRule$|/messageRules\\b", "creates or changes an inbox rule (a common attacker foothold)"],
    ["(?i)^(New|Set)-TransportRule$|^(New|Set)-(Inbound|Outbound)Connector$|^Set-RemoteDomain$", "changes how mail flows in or out of the tenant"],
    ["(?i)^Set-CASMailbox$|^Set-OrganizationConfig$|^Set-AuthenticationPolicy$|^Set-OwaMailboxPolicy$", "changes tenant-wide mail or client access settings"],
    ["(?i)^(Set|Disable)-AdminAuditLogConfig$|^Set-MailboxAuditBypassAssociation$|AuditDisabled|-AuditEnabled[\\s:]+\\$false", "weakens audit logging"],
    ["(?i)ConditionalAccess|^Update-Mg(Beta)?PolicyAuthorizationPolicy$|^Update-Mg(Beta)?PolicyAuthenticationMethodPolicy$|^Update-Mg(Beta)?PolicyIdentitySecurityDefaultEnforcementPolicy$|^Set-MsolCompanySettings$|^Update-Mg(Beta)?PolicyCrossTenantAccessPolicy", "changes a tenant security policy"],
    ["(?i)^(New|Update|Remove)-Mg(Beta)?UserAuthentication\\w*Method|StrongAuthentication|^Reset-Mg(Beta)?UserAuthenticationMethodPassword$|^Set-MsolUser\\b.*-StrongAuthentication|PasswordProfile|^Set-MsolUserPassword$|^Set-AzureADUserPassword$|^Set-Entra(Beta)?UserPassword$|^(New|Update|Remove|Reset)-Entra(Beta)?\\w*Authentication\\w*Method", "changes a user's password or second factor"],
    ["(?i)^(New|Update|Remove)-Mg(Beta)?(Application|ServicePrincipal)|^Add-Mg(Beta)?(Application|ServicePrincipal)(Password|Key)$|^New-Mg(Beta)?Oauth2PermissionGrant$|^New-Mg(Beta)?ServicePrincipalAppRoleAssignment|^New-AzureADApplication|^New-AzureADServicePrincipal|-AllowAppRegistration|^(New|Set|Remove)-Entra(Beta)?(Application|ServicePrincipal)$|^(New|Remove)-Entra(Beta)?(Application|ServicePrincipal)(Password|Key)?Credential$|^Add-Entra(Beta)?(Application|ServicePrincipal)Owner$|^New-Entra(Beta)?Oauth2PermissionGrant$|^New-Entra(Beta)?ServicePrincipalAppRoleAssignment$", "creates or changes an app registration, secret or app permission"],
    ["(?i)^New-Mg(Beta)?DirectoryRoleMemberByRef$|^New-Mg(Beta)?RoleManagementDirectoryRoleAssignment|^Add-MsolRoleMember$|^Add-AzureADDirectoryRoleMember$|^Add-RoleGroupMember$|^New-ManagementRoleAssignment$|^New-Mg(Beta)?RoleManagementDirectoryRoleEligibility|^Set-SPOUser\\b.*-IsSiteCollectionAdmin|^Add-Entra(Beta)?DirectoryRoleMember$|^New-Entra(Beta)?DirectoryRoleAssignment$", "grants an admin role"],
    ["(?i)^(New|Remove)-Mg(Beta)?User$|^(New|Remove)-Mailbox$|^(New|Remove)-MsolUser$|^(New|Remove)-AzureADUser$|^(New|Remove)-Entra(Beta)?User$", "creates or deletes a user account"],
    ["(?i)^Set-SPOTenant$|^Set-SPOSite\\b.*-SharingCapability|^Set-PnPTenant$|SharingCapability|-ExternalUserAndGuestSharing", "changes external sharing"],
    ["(?i)^New-Mg(Beta)?Invitation$|^New-AzureADMSInvitation$|GuestUser|^New-Entra(Beta)?Invitation$", "invites an external (guest) user"],
    ["(?i)^Set-Mg(Beta)?User\\b.*-AccountEnabled|^Update-Mg(Beta)?User\\b.*-AccountEnabled|^Set-MsolUser\\b.*-BlockCredential|^Set-AzureADUser\\b.*-AccountEnabled|^Set-Entra(Beta)?User\\b.*-AccountEnabled", "enables or disables sign-in for an account"],
    ["(?i)^(Enable|Disable)-Mailbox$|^Set-Mailbox\\b.*-LitigationHold|-RetentionHoldEnabled", "changes mailbox holds or mailbox state"],
    ["(?i)^Set-MsolDomainAuthentication$|^Set-MsolDomainFederationSettings$|^(New|Update)-Mg(Beta)?DomainFederationConfiguration$|^Set-Entra(Beta)?DomainFederationSettings$|-Authentication\\s+Federated\\b|-PassiveLogOnUri\\b", "changes how a domain signs in (federation); a hostile identity provider can sign in as anyone"],
    ["(?i)^(Set|Disable|Remove)-(AntiPhish|SafeLinks|SafeAttachment|MalwareFilter|HostedContentFilter|HostedOutboundSpamFilter|HostedConnectionFilter|Atp|EOP)\\w*$|^Disable-TransportRule$|^Remove-TransportRule$", "weakens or removes mail protection"],
    ["(?i)^New-TenantAllowBlockListItems\\b.*-Allow\\b|-AllowedSenderDomains\\b|-AllowedSenders\\b|-IPAllowList\\b", "allow-lists a sender, domain or address past the spam and phishing filters"],
    ["(?i)^(Set|Remove)-(CaseHoldPolicy|CaseHoldRule|RetentionCompliancePolicy|RetentionComplianceRule|DlpCompliancePolicy|DlpComplianceRule|ProtectionAlert|ActivityAlert|SupervisoryReviewPolicyV2|Label|LabelPolicy)$|^Set-ComplianceCase\\b.*-Status\\s+Closed", "changes a hold, retention, DLP, label or alert policy"],
    ["(?i)^New-(AuthServer|PartnerApplication|ApplicationAccessPolicy)$|^Set-AuthConfig$", "lets an application sign in to Exchange Online on its own"],
    ["(?i)^(New|Update|Remove)-Mg(Beta)?Policy(AuthorizationPolicy|AuthenticationMethodPolicy|AuthenticationStrengthPolicy|AuthenticationFlowPolicy|AdminConsentRequestPolicy|PermissionGrantPolicy\\w*|DefaultAppManagementPolicy|AppManagementPolicy\\w*|TokenLifetimePolicy|CrossTenantAccessPolicy\\w*|IdentitySecurityDefaultEnforcementPolicy|FeatureRolloutPolicy\\w*)$|^(New|Update)-Mg(Beta)?Oauth2PermissionGrant$|^Update-Mg(Beta)?Organization$|^Update-Mg(Beta)?AdminSharepointSetting$", "changes a tenant consent, sign-in or app policy"],
    ["(?i)^Add-PnPSiteCollectionAdmin$|^Set-PnP(Tenant)?Site\\b.*-Owners|^Set-SPOSite\\b.*-Owner\\b|^Add-PnPSiteCollectionAppCatalog$|^New-AzRoleAssignment$|^New-AzADAppCredential$|^New-AzADSpCredential$|^New-AzADServicePrincipal$", "grants an admin role or owner rights"],
    ["(?i)^Approve-(SPO|PnP)TenantServicePrincipalPermissionRequest$|^Grant-PnP(AzureAD|EntraID)App\\w*Permission$|^Grant-PnPTenantServicePrincipalPermission$|^Register-PnP(AzureAD|EntraID)App\\w*$|^Add-PnP(AzureAD|EntraID)ServicePrincipalAppRole\\w*$|^(Add|Install|Publish)-PnPApp$|^Set-AzKeyVaultAccessPolicy$", "grants an app access to SharePoint, the tenant or a key vault"],
    ["(?i)ConvertTo-SecureString\\s.*-AsPlainText|-ClientSecret\\s+['\"]|-Password\\s+['\"]|-CertificateThumbprint|-ClientSecretCredential", "carries a credential inside the script"],
    ["(?i)^New-CsTeamsAppPermissionPolicy|^Set-CsTenantFederationConfiguration$|^Set-CsExternalAccessPolicy$", "changes Teams external access"],
    ["(?i)^Send-Mg(Beta)?UserMail$|^Send-Mg(Beta)?UserMessage|^Send-MailMessage$|^Send-PnPMail$", "sends email; collected data can leave this way"],
    ["(?i)Win32_Process\\b", "starts a program through WMI (Win32_Process Create)"],
    ["(?i)GetNetworkCredential\\(\\)\\.Password|ConvertFrom-SecureString\\s.*-AsPlainText", "turns a password back into plain text"],
    ["(?i)^Release-QuarantineMessage$", "releases quarantined mail, held as spam, phishing or malware, to its recipients"],
    ["(?i)ActivationLock$", "bypasses Activation Lock on a device"],
    ["(?i)^Connect-Mailbox$", "gives a user account full access to a mailbox and all its mail"],
    ["(?i)PasswordSingleSignOnCredential", "reads or changes the passwords stored for password-based single sign-on"]
  ],
  "undo": [
    ["^Remove-Mg(Beta)?DirectoryDeletedItem$|^Remove-SPODeletedSite$|^Remove-PnPTenantDeletedSite$|^Remove-PnPDeletedMicrosoft365Group$", "none: this empties the recycle bin for that object, so it cannot be restored", ""],
    ["^Remove-Mg(Beta)?User$|^Remove-AzureADUser$|^Remove-MsolUser$|^Remove-Entra(Beta)?User$", "an admin can restore a deleted user for 30 days", "https://learn.microsoft.com/entra/fundamentals/users-restore"],
    ["^Remove-Mg(Beta)?Group$|^Remove-UnifiedGroup$|^Remove-AzureADMSGroup$|^Remove-Entra(Beta)?Group$", "a Microsoft 365 group or cloud security group can be restored for 30 days; Microsoft documents no window for other group types", "https://learn.microsoft.com/entra/identity/users/groups-restore-deleted"],
    ["^Remove-Mailbox$", "a deleted mailbox can be restored for 30 days", "https://learn.microsoft.com/exchange/recipients-in-exchange-online/delete-or-restore-mailboxes"],
    ["^Remove-Mg(Beta)?(Application|ServicePrincipal)$|^Remove-AzureADApplication$|^Remove-Entra(Beta)?Application$", "a deleted app registration can be restored for 30 days", "https://learn.microsoft.com/entra/identity-platform/howto-restore-app"],
    ["^Remove-SPOSite$|^Remove-PnPTenantSite$", "a deleted site stays in the tenant recycle bin for 93 days", "https://learn.microsoft.com/sharepoint/restore-deleted-site-collection"],
    ["^Remove-Team$", "a deleted team is a deleted Microsoft 365 group, restorable for 30 days", "https://learn.microsoft.com/microsoftteams/archive-or-delete-a-team"],
    ["^Remove-Mg(Beta)?Device$|^Remove-AzureADDevice$|^Remove-Entra(Beta)?Device$", "Microsoft documents no restore for a deleted device", ""],
    ["^Remove-DistributionGroup$|^Remove-MailContact$|^Remove-MailUser$", "Microsoft documents no restore; recreate by hand", ""]
  ],
  "param_notes": [
    ["^(New|Set)-TransportRule$", ["-SentTo", "-ExceptIfSentTo"], "a distribution group in -SentTo or -ExceptIfSentTo fails when the rule is created (\"SentTo predicate does not allow distribution groups\", seen 2026-10-09); for a group use -SentToMemberOf or -ExceptIfSentToMemberOf"]
