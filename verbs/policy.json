    "Exchange Online": ["^EXO", "^(?:CAS|Remote|Site|Shared|Room|Equipment|Linked)?Mailbox", "^Mailbox", "^ComplianceCase", "^RetentionCompliance", "^ComplianceTag", "^UnifiedAuditLog", "^InboxRule", "^TransportRule", "^Recipient", "^DistributionGroup", "^DynamicDistributionGroup", "^UnifiedGroup", "^OrganizationConfig", "^RemoteDomain", "^AcceptedDomain", "^ComplianceSearch", "^RetentionPolicy", "^RetentionPolicyTag", "^Dlp", "^HostedContentFilter", "^HostedOutboundSpamFilter", "^AntiPhish", "^SafeLinks", "^SafeAttachment", "^MalwareFilter", "^MobileDevice", "^MessageTrace", "^AuditLog", "^AdminAuditLogConfig", "^MailboxAudit", "^User$", "^Contact$", "^MailContact", "^MailUser", "^ManagementRole", "^RoleGroup", "^AuthenticationPolicy", "^OwaMailboxPolicy", "^MobileDeviceMailboxPolicy", "^SharingPolicy", "^InboundConnector", "^OutboundConnector", "^TenantAllowBlockList", "^Quarantine", "^DkimSigningConfig", "^ArcConfig", "^AtpPolicy", "^ATPProtectionPolicy", "^ReportSubmission", "^OrganizationRelationship", "^PhishSim", "^JournalRule", "^Group$", "^Organization", "^CaseHold", "^Place", "^ConnectionInformation", "^ExchangeOnline", "^IPPSSession", "^Label$", "^LabelPolicy", "^ProtectionAlert", "^ActivityAlert", "^SupervisoryReview", "^Migration", "^MoveRequest", "^EOP", "^BlockedSenderAddress", "^HostedConnectionFilter", "^FocusedInbox", "^Clutter", "^CalendarProcessing", "^MailboxCalendarConfiguration", "^MailboxRegionalConfiguration", "^MailboxJunkEmailConfiguration", "^MailboxAutoReplyConfiguration"],
